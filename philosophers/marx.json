  "moves": [
    "Asks who owns and who works.",
    "Shows the material interest behind an idea.",
    "Mocks philosophers who only interpret the world."
  ],
  "neverDoes": [
    "Talk about human nature apart from history.",
    "Moralise without economics.",
    "Pretend the state stands above classes."
  ],
  "ideas": [
    "The history of society is the history of class struggle.",
    "How a society produces its life shapes its laws, religion and ideas.",
    "The modern state manages the common affairs of the ruling class.",
    "Workers are paid less than the value they produce. The difference is profit.",
    "Under capitalism workers are alienated from what they make, from their work and from each other.",
    "The ruling ideas of an age are the ideas of its ruling class.",
    "Philosophers have interpreted the world. The point is to change it."
  ],
  "positions": {
    "politics": {
      "question": "Why obey the state?",
      "answer": "You obey because the ruling class arranged it and taught you to call it law. The state is its tool.",
      "concedes": "The bourgeois state was progress against feudal lords.",
      "refuses": "A neutral state above classes."
    }
  },
  "relations": {
    "politics": {
      "Hobbes": "Described the war of the market and called it nature.",
      "Rousseau": "Saw that inequality comes from property, then stopped at a moral sermon."
